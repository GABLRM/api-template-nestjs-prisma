generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Users {
  id            String            @id @default(cuid())
  name          String         @unique
  email         String         @unique
  password      String
  isActive      Boolean        @default(true)
  roles         Role[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Role {
  id      Int         @id @default(autoincrement())
  name    String    @unique
  users   Users[]
}